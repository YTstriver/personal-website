# 开启严格控流量模式：
# true  = 预览卡片只展示封面图，不主动请求视频流
# false = 保持当前视频预览行为
VITE_STRICT_TRAFFIC_MODE=true

# OSS/CDN 视频前缀（可留空，留空则继续走站点内 /videos）
# 示例: https://cdn.example.com
VITE_OSS_VIDEO_BASE_URL=

# OSS/CDN 封面图前缀（可留空）
# 约定：封面图文件名与视频同名，扩展名为 .jpg
# 例如视频 /videos/地铁站.mp4 对应封面 https://cdn.example.com/covers/地铁站.jpg
VITE_OSS_VIDEO_POSTER_BASE_URL=
